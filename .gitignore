# .gitignore
# -----------
# Keep secrets and generated files out of version control.

# --- Environment / secrets ---
.env
*.env
!.env.example        # but DO commit the example template

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
.venv/
*.egg-info/
dist/
build/

# --- ChromaDB data ---
# Too large for GitHub (files exceed 100 MB limit). Generate locally by running ingest_large.py.
chroma_db/

# --- Ingestion state ---
ingestion_progress.json

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# --- Test artifacts ---
.pytest_cache/
htmlcov/
.coverage
