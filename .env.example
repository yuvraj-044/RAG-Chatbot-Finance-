# .env.example
# -------------
# Copy this file to .env and fill in your values for local development.
#   cp .env.example .env
#
# !! NEVER commit .env to git. It is already in .gitignore. !!
#
# On Hugging Face Spaces, set these as Space Secrets:
#   Space Settings → Variables and Secrets → New Secret
# (Do NOT upload a .env file to HF Spaces — use Secrets instead)

# =============================================================================
# GROQ LLM
# =============================================================================
# Get your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Which Groq model to use. Options (as of mid-2025):
#   llama-3.1-8b-instant    — fastest, good for demos
#   llama-3.1-70b-versatile — better quality, slightly slower
#   mixtral-8x7b-32768      — large context window
GROQ_MODEL=llama-3.1-8b-instant

# =============================================================================
# CHROMADB
# =============================================================================
# Path to the ChromaDB persistence directory that your teammate created
# during the ingestion/embedding step. Can be relative (./chroma_db) or absolute.
CHROMA_PERSIST_DIR=./chroma_db

# The name of the ChromaDB collection — must match what your teammate used
# when they called: chromadb.Client().create_collection("finance_docs")
CHROMA_COLLECTION_NAME=finance_docs

# =============================================================================
# API BEHAVIOUR (optional — defaults are shown)
# =============================================================================
# Number of retrieved document chunks to pass to the LLM as context
TOP_K_RESULTS=5

# Seconds to wait for a Groq response before timing out with a 503
LLM_TIMEOUT_SECONDS=30

# Max conversation turns to keep in memory per session (older turns are dropped)
# 1 turn = 1 user message + 1 assistant reply
MAX_HISTORY_TURNS=10
